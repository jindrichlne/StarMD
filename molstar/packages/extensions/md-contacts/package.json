{
  "name": "@molstar/md-contacts-extension",
  "version": "6.0.0-dev.0",
  "type": "module",
  "description": "Mol* md-contacts-extension: contact maps, stability and conformers of MD trajectories (GROMACS)",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    "./*": {
      "molstar-src": "./src/*.ts",
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    },
    "./ui/*": {
      "molstar-src": "./src/ui/*.tsx",
      "types": "./lib/ui/*.d.ts",
      "import": "./lib/ui/*.js"
    },
    "./ui/style.css": "./src/ui/style.css",
    "./_test/*": null
  },
  "files": [
    "lib",
    "src",
    "!**/_test/**",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "rxjs": "catalog:",
    "@types/react": "catalog:",
    "tslib": "catalog:",
    "@molstar/core": "workspace:*",
    "@molstar/model": "workspace:*",
    "@molstar/plugin": "workspace:*",
    "@molstar/plugin-extension": "workspace:*",
    "@molstar/graphics": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:",
    "react": "catalog:"
  },
  "peerDependencies": {
    "react": ">=16.14.0"
  }
}
