; Soft-core pre-minimisation 2 (lambda 0.99, all atoms free)
; SLC35A2 in POPC:POPE:CHL 40:40:20 | amber14sb + TIP3P + Lipid21 | GROMACS 2026

define                   = -DPOSRES -DPOSRES_FC_BB=4000.0 -DPOSRES_FC_SC=2000.0 -DPOSRES_LIPID -DPOSRES_FC_LIPID=1000.0
integrator               = steep
emtol                    = 1000.0
emstep                   = 0.01
nsteps                   = 10000
nstenergy                = 500
nstlog                   = 500

; ---- Non-bonded: Amber ff14SB / Lipid21 conventions ------------------------
; 1.0 nm LJ cut-off (Potential-shift only shifts the energy; forces are those of
; Amber's plain truncation), PME with 1.0 nm real-space cut-off.
; NO long-range dispersion correction.
cutoff-scheme            = Verlet
nstlist                  = 20
pbc                      = xyz
verlet-buffer-tolerance  = 0.005
coulombtype              = PME
rcoulomb                 = 1.0
vdwtype                  = Cut-off
vdw-modifier             = Potential-shift
rvdw                     = 1.0
DispCorr                 = no
fourierspacing           = 0.12
pme-order                = 4
ewald-rtol               = 1e-5

constraints              = none

; ---- all non-bonded interactions at lambda = 0.99 with soft-core (finite at r = 0)
free-energy              = yes
couple-moltype           = system
couple-lambda0           = none
couple-lambda1           = vdw-q
couple-intramol          = yes
init-lambda-state        = 0
vdw-lambdas              = 0.99
coul-lambdas             = 0.99
sc-alpha                 = 0.5
sc-power                 = 1
sc-sigma                 = 0.3
sc-coul                  = yes
nstdhdl                  = 0
